# Copy this file to .env and fill in your values.
# Restart the dev server after any change to .env.

# Your workspace REST API base URL, e.g. http://localhost:3000/api/v1
VITE_REST_URL=http://localhost:3000/api/v1

# The user ID of a workspace administrator
VITE_ADMIN_USER_ID=<admin-user-id>

# A personal access token for that administrator
VITE_ADMIN_ACCESS_TOKEN=<admin-personal-access-token>

# Must match CREATE_TOKENS_FOR_USERS_SECRET in your workspace deployment
VITE_CREATE_TOKEN_SECRET=<your-shared-secret>
